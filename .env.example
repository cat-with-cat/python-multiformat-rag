# Never commit real keys. The retrieve command works without any LLM key.
# Keep dashscope for the existing provider, or select openai_compatible for OpenLux.
LLM_PROVIDER=dashscope
LLM_BASE_URL=https://api.openlux.ai/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Used only when LLM_PROVIDER=dashscope.
DASHSCOPE_API_KEY=

RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_LLM_MODEL=qwen-turbo
RAG_INDEX_DIR=.rag_index
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35
